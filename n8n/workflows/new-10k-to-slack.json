        "jsCode": "// Verify a Standard Webhooks signature (ADR-0005), like verified_event in inbound.py.\n// Output one item: { valid: true, event } or { valid: false, reason }. Never throw: an error\n// here becomes a 500, and our dispatcher would retry a request that can never pass.\nconst crypto = require('crypto');\nconst TOLERANCE_SECONDS = 5 * 60;\n\nconst headers = $input.first().json.headers; // n8n lowercases header names\n// The raw bytes, exactly as signed (Webhook node option \"Raw Body\"); $json.body is re-parsed JSON\nconst body = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst reject = (reason) => [{ json: { valid: false, reason } }];\n\nconst secret = $env.WEBHOOK_SIGNING_SECRET;\nif (!secret) return reject('WEBHOOK_SIGNING_SECRET is not set in n8n');\nconst id = headers['webhook-id'];\nconst timestamp = headers['webhook-timestamp'];\nconst signatures = headers['webhook-signature'];\nif (!id || !timestamp || !signatures) return reject('missing webhook headers');\nconst seconds = Number(timestamp);\nif (!Number.isFinite(seconds) || Math.abs(Date.now() / 1000 - seconds) > TOLERANCE_SECONDS)\n  return reject('timestamp outside tolerance');\nconst key = Buffer.from(secret.replace(/^whsec_/, ''), 'base64');\nconst expected = crypto.createHmac('sha256', key).update(`${id}.${timestamp}.${body}`).digest();\nconst valid = signatures.split(' ').some((entry) => {\n  const [version, sig] = entry.split(',');\n  if (version !== 'v1' || !sig) return false;\n  const given = Buffer.from(sig, 'base64');\n  return given.length === expected.length && crypto.timingSafeEqual(given, expected);\n});\nif (!valid) return reject('bad signature');\nreturn [{ json: { valid: true, event: JSON.parse(body) } }];\n"
      },
