# Copy to .env and fill in. Never commit .env.
# Each key notes the sprint that introduces it.

# --- Sprint 0: local database ---
DATABASE_URL=postgresql+psycopg://market_desk:market_desk@localhost:5432/market_desk

# --- Sprint 1: data sources and integrations ---
CALA_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with a contact email
EDGAR_USER_AGENT="Market Desk your.email@example.com"
# Development only: cache EDGAR responses on disk (leave empty to disable)
EDGAR_CACHE_DIR=.cache/edgar
# Webhook signing secret (Standard Webhooks). Generate one with:
#   uv run python -c "import base64,secrets;print('whsec_'+base64.b64encode(secrets.token_bytes(32)).decode())"
WEBHOOK_SIGNING_SECRET=
# Slack incoming webhook (api.slack.com/apps > your app > Incoming Webhooks). A secret:
# anyone with it can post to the channel. Only the n8n container gets it.
SLACK_WEBHOOK_URL=
# Where outbound events go: the n8n workflow's production URL (n8n/README.md).
# From the host; a container would use http://n8n:5678/webhook/market-desk
N8N_WEBHOOK_URL=http://localhost:5678/webhook/market-desk
# How often the API checks EDGAR for new watchlist filings; 0 = off (task 7)
FILING_CHECK_INTERVAL_MINUTES=0

# --- Sprint 2: LLM ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
CHEAP_MODEL=claude-haiku-5-5

# --- Sprint 5: voice ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Optional stretch: phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Sprint 6: observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Sprint 7: AWS (local Terraform runs only; CI uses OIDC, no keys) ---
AWS_PROFILE=
AWS_REGION=eu-west-1
